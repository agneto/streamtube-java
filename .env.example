# Copy to .env for local overrides. Compose provides these defaults already.

# API
SERVER_PORT=8080

# PostgreSQL (host = Compose service name)
DB_HOST=db
DB_PORT=5432
DB_NAME=streamtube
DB_USERNAME=streamtube
DB_PASSWORD=streamtube

# RabbitMQ (used from Phase 03)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=streamtube
RABBITMQ_PASSWORD=streamtube

# Object storage / MinIO (used from Phase 03)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=streamtube-videos
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube_secret

# Mail / Mailpit (used from Phase 02)
MAIL_HOST=mailpit
MAIL_PORT=1025
