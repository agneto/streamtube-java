# --- build stage ---
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src

# Dependency layer: copy only the build scripts and resolve dependencies, so source-only
# changes reuse this (expensive) layer instead of re-downloading everything.
COPY gradlew ./
COPY gradle/ gradle/
COPY settings.gradle.kts build.gradle.kts ./
COPY domain/build.gradle.kts domain/
COPY application/build.gradle.kts application/
COPY infrastructure/build.gradle.kts infrastructure/
COPY bootstrap-api/build.gradle.kts bootstrap-api/
COPY bootstrap-worker/build.gradle.kts bootstrap-worker/
RUN ./gradlew :bootstrap-worker:dependencies --no-daemon --quiet > /dev/null

COPY . .
# Layered jar: dependencies / loader / application extract into separate image layers,
# so pulling a new build only transfers the application layer.
RUN ./gradlew :bootstrap-worker:bootJar --no-daemon \
    && java -Djarmode=layertools -jar bootstrap-worker/build/libs/streamtube-worker.jar extract \
       --destination /extracted

# --- runtime stage (with ffmpeg/ffprobe) ---
FROM eclipse-temurin:21-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1001 --user-group app
WORKDIR /app
COPY --from=build /extracted/dependencies/ ./
COPY --from=build /extracted/spring-boot-loader/ ./
COPY --from=build /extracted/snapshot-dependencies/ ./
COPY --from=build /extracted/application/ ./
USER app
# Management/health port (served once the observability change lands).
EXPOSE 8081
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "org.springframework.boot.loader.launch.JarLauncher"]
